    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item) => {\n  // The Webhook node places incoming request data inside body.\n  const body = item.json.body ?? {};\n\n  const user = body.user;\n  const message = body.message;\n\n  const errors = [];\n\n  // Check that user is present and is text.\n  if (typeof user !== \"string\" || user.trim() === \"\") {\n    errors.push(\"User is required and must be text.\");\n  }\n\n  // Check that message is present and is text.\n  if (typeof message !== \"string\" || message.trim() === \"\") {\n    errors.push(\"Message is required and must be text.\");\n  }\n\n  // Match the FastAPI request limit of 2,000 characters.\n  if (typeof message === \"string\" && message.length > 2000) {\n    errors.push(\"Message must not exceed 2000 characters.\");\n  }\n\n  return {\n    json: {\n      ...item.json,\n      user: typeof user === \"string\" ? user.trim() : \"\",\n      message: typeof message === \"string\" ? message.trim() : \"\",\n      isValid: errors.length === 0,\n      validationError: errors.join(\" \")\n    }\n  };\n});\n"
      },
