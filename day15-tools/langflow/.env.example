# Copy to `.env` (next to docker-compose.yml). Never commit `.env`.
# Make a strong password with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<generate-a-strong-value>

# Must match the employee API key configured in day8-pgvector.
EMPLOYEE_API_KEY=<set-a-strong-employee-api-key>
