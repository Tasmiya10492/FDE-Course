    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const body = item.json.body ?? {};\n\n  const user = body.user;\n  const message = body.message;\n\n  const valid =\n    typeof user === \"string\" &&\n    user.trim().length > 0 &&\n    typeof message === \"string\" &&\n    message.trim().length > 0 &&\n    message.length <= 2000;\n\n  return {\n    json: {\n      ...item.json,\n      isValid: valid,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
