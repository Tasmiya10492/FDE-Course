# Copy this file to .env.day18 and replace every placeholder.
POSTGRES_DB=fde_hr
POSTGRES_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-random-value

APP_DB_USER=hr_app
APP_DB_PASSWORD=replace-with-a-different-strong-random-value

SESSION_SECRET=replace-with-a-long-random-secret
EMPLOYEE_API_KEY=replace-with-an-employee-api-key
HR_API_KEY=replace-with-a-different-hr-api-key

ENVIRONMENT=production
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen3.5:2b

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.5:2b
LLM_API_KEY=ollama
