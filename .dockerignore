# .dockerignore: files that must NOT be copied into the image (Playbook CTR-04).
# Secrets and local clutter stay out of the image layers.
# Git metadata
.git
.gitignore
.github

# Environment files and secrets
.env
.env.*
!.env.example
*.env
app.env

# Python environments and caches
.venv
**/.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.pyright

# Test and development artifacts
tests
**/tests
docs
**/docs
*.bak
*.log

# Generated files
results
**/results
.coverage
htmlcov
